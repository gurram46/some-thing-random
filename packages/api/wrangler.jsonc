/**
 * Wrangler configuration for the reader API.
 *
 * IMPORTANT: all resource identifiers below are LOCAL DEVELOPMENT
 * PLACEHOLDERS. They are sufficient for `wrangler dev` (local mode,
 * backed by miniflare's local D1/R2 simulations) but MUST be replaced
 * with real values before deploying to Cloudflare:
 *
 *   D1  "database_id"    -> run `wrangler d1 create reader-db`
 *                            and paste the returned database_id.
 *   R2  "bucket_name"    -> run `wrangler r2 bucket create <name>`
 *                            and use the real bucket name.
 *
 * Do not treat the zero UUID or the "-local" bucket name as real.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reader-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reader-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "reader-audio-local"
    }
  ]
}
